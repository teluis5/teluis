---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Ad from '../components/Ad.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, categories } = Astro.props;
---

<html lang="ja">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			.hero-image {
				width: 100%;
				margin-bottom: 2rem;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				width: 100%;
				max-height: 500px;
				object-fit: cover;
			}
			.prose {
				color: var(--text-main);
				font-size: 1.05rem;
			}
			.title {
				margin-bottom: 2em;
				line-height: 1.4;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
				font-size: 1.8rem;
			}
			.date {
				margin-bottom: 1em;
				color: var(--text-light);
				font-size: 0.9em;
				display: flex;
				gap: 1em;
				align-items: center;
			}
			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin-bottom: 1rem;
			}
			.tag {
				display: inline-block;
				background-color: #e0f2fe;
				color: #0369a1;
				padding: 0.2rem 0.6rem;
				border-radius: 9999px;
				font-size: 0.85rem;
				text-decoration: none;
				font-weight: 600;
			}
			.tag:hover {
				background-color: #bae6fd;
			}
			/* Sidebar Widgets */
			.widget {
				padding: 1.5rem;
				margin-bottom: 2rem;
			}
			.widget-title {
				font-size: 1.1rem;
				color: var(--text-main);
				background-color: #f7f7f7;
				padding: 0.5rem 1rem;
				border-left: 4px solid var(--theme-accent);
				margin: -1.5rem -1.5rem 1.5rem -1.5rem;
			}
			.profile-pic {
				width: 100px;
				height: 100px;
				border-radius: 50%;
				margin: 0 auto 1rem;
				background-color: var(--border-color);
				display: block;
			}
			.profile-desc {
				font-size: 0.9rem;
				color: var(--text-main);
				text-align: center;
				line-height: 1.6;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<div class="layout-container">
				<!-- メインコンテンツ (左カラム) -->
				<article class="layout-main box" style="padding: 2rem;">
					<div class="title">
						<div class="date">
							<span>📅 <FormattedDate date={pubDate} /></span>
							{
								updatedDate && (
									<span>🔄 <FormattedDate date={updatedDate} /></span>
								)
							}
						</div>
						<h1>{title}</h1>
						{categories && categories.length > 0 && (
							<div class="tags">
								{categories.map((category: string) => (
									<a href={`/category/${category}`} class="tag">{category}</a>
								))}
							</div>
						)}
					</div>
					
					<div class="hero-image">
						{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
					</div>
					
					<div class="prose">
						<slot />
						
						<!-- 記事下広告 -->
						<div style="margin-top: 3rem;">
							<Ad />
						</div>
					</div>
				</article>

				<!-- サイドバー (右カラム) -->
				<aside class="layout-sidebar">
					<!-- プロフィールウィジェット -->
					<div class="widget box">
						<div class="widget-title">プロフィール</div>
						<img src="/avatar.jpg" alt="Teluis" class="profile-pic" style="object-fit: cover;" />
						<p class="profile-desc" style="text-align: left;">
							<strong>ITエンジニア / コンサルタント</strong><br/>
							日経大手企業でキャリアをスタートし、AIスタートアップでの開発経験を経て、現在はコンサルティングファームに勤務。ビジネスマンに必要なスキルや、日々の業務で得た実践的なエッセンスを発信しています。
						</p>
					</div>

					<!-- サイドバー広告 -->
					<div class="widget box" style="padding: 1rem; text-align: center;">
						<div style="font-size:0.8rem; color:var(--text-light); margin-bottom:0.5rem;">スポンサーリンク</div>
						<Ad />
					</div>
				</aside>
			</div>
		</main>
		<Footer />
	</body>
</html>
