---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.entry-list {
				display: flex;
				flex-direction: column;
				gap: 1rem;
				list-style: none;
				padding: 0;
				margin: 0;
			}
			.entry-card {
				display: flex;
				background-color: var(--bg-content);
				border: 1px solid var(--border-color);
				border-radius: var(--radius);
				overflow: hidden;
				text-decoration: none;
				color: var(--text-main);
				transition: background-color 0.2s;
			}
			.entry-card:hover {
				background-color: #fafafa;
				text-decoration: none;
			}
			.entry-thumb {
				flex: 0 0 300px;
				aspect-ratio: 16/9;
				overflow: hidden;
				background-color: var(--border-color);
			}
			.entry-thumb img {
				width: 100%;
				height: 100%;
				object-fit: cover;
			}
			.entry-content {
				padding: 1.5rem;
				display: flex;
				flex-direction: column;
				justify-content: center;
			}
			.entry-title {
				font-size: 1.25rem;
				margin: 0 0 0.5rem 0;
				line-height: 1.4;
			}
			.entry-date {
				font-size: 0.9rem;
				color: var(--text-light);
				margin: 0;
			}
			
			/* Sidebar Widgets */
			.widget {
				padding: 1.5rem;
				margin-bottom: 2rem;
			}
			.widget-title {
				font-size: 1.1rem;
				color: var(--text-main);
				background-color: #f7f7f7;
				padding: 0.5rem 1rem;
				border-left: 4px solid var(--theme-accent);
				margin: -1.5rem -1.5rem 1.5rem -1.5rem;
			}
			
			@media (max-width: 720px) {
				.entry-card {
					flex-direction: column;
				}
				.entry-thumb {
					flex: auto;
					width: 100%;
				}
				.entry-content {
					padding: 1rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="layout-container">
				<!-- メインコンテンツ (左カラム) -->
				<div class="layout-main">
					<div class="entry-list">
						{
							posts.map((post) => (
								<a href={`/blog/${post.id}/`} class="entry-card box">
									<div class="entry-thumb">
										{post.data.heroImage ? (
											<Image width={720} height={405} src={post.data.heroImage} alt="" />
										) : (
											<div style="width:100%; height:100%; background:#e0e0e0;"></div>
										)}
									</div>
									<div class="entry-content">
										<h2 class="entry-title">{post.data.title}</h2>
										<p class="entry-date">
											<FormattedDate date={post.data.pubDate} />
										</p>
									</div>
								</a>
							))
						}
					</div>
				</div>

				<!-- サイドバー (右カラム) -->
				<aside class="layout-sidebar">
					<div class="widget box">
						<div class="widget-title">プロフィール</div>
						<div class="profile-pic" style="width: 100px; height: 100px; border-radius: 50%; margin: 0 auto 1rem; background-color: var(--border-color); display: block;"></div>
						<p class="profile-desc" style="font-size: 0.9rem; color: var(--text-main); text-align: left; line-height: 1.6;">
							<strong>ITエンジニア / コンサルタント</strong><br/>
							日経大手企業でキャリアをスタートし、AIスタートアップでの開発経験を経て、現在はコンサルティングファームに勤務。ビジネスマンに必要なスキルや、日々の業務で得た実践的なエッセンスを発信しています。
						</p>
					</div>

					<div class="widget box">
						<div class="widget-title">新着記事</div>
						<ul style="list-style:none; padding:0; margin:0; font-size:0.95em;">
							{posts.slice(0, 5).map((post) => (
								<li style="border-bottom: 1px dashed var(--border-color); padding: 0.5rem 0;">
									<a href={`/blog/${post.id}/`} style="color:var(--text-main);">{post.data.title}</a>
								</li>
							))}
						</ul>
					</div>
				</aside>
			</div>
		</main>
		<Footer />
	</body>
</html>
