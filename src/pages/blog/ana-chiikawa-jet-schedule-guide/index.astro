---
// ANAちいかわジェット 運行ガイド 恒久移転（ヨミトク yomileeへ一本化）
const targetUrl = "https://yomileeblog.com/site/chiikawajet/";
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>ANAちいかわジェット 本日の運航状況・フライト予定（移転のお知らせ） | teluis</title>
		<meta name="description" content="ANA特別塗装機「ちいかわジェット（JA609A）」の本日のリアルタイム運航状況および週間フライト予想は、特化メディア『ヨミトク（yomilee）』へ移転・一本化されました。" />
		<link rel="canonical" href={targetUrl} />
		<meta http-equiv="refresh" content={`0;url=${targetUrl}`} />
		<script is:inline define:vars={{ targetUrl }}>
			window.location.replace(targetUrl);
		</script>
		<style>
			body {
				font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
				display: flex;
				align-items: center;
				justify-content: center;
				min-height: 100vh;
				margin: 0;
				background-color: #f8fafc;
				color: #0f172a;
				padding: 1.5rem;
				box-sizing: border-box;
			}
			.redirect-card {
				background: #ffffff;
				border: 1px solid #e2e8f0;
				border-radius: 12px;
				padding: 2.5rem 2rem;
				max-width: 520px;
				text-align: center;
				box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);
			}
			.badge {
				display: inline-block;
				background: #dbeafe;
				color: #1d4ed8;
				font-size: 0.85rem;
				font-weight: 700;
				padding: 0.25rem 0.75rem;
				border-radius: 9999px;
				margin-bottom: 1rem;
			}
			h1 {
				font-size: 1.35rem;
				line-height: 1.5;
				margin: 0 0 1rem;
				color: #0f172a;
			}
			p {
				color: #475569;
				font-size: 0.95rem;
				line-height: 1.7;
				margin: 0 0 1.5rem;
			}
			.btn-redirect {
				display: inline-block;
				background: #0284c7;
				color: #ffffff;
				text-decoration: none;
				font-weight: 700;
				font-size: 1rem;
				padding: 0.85rem 1.8rem;
				border-radius: 8px;
				transition: background 0.2s;
			}
			.btn-redirect:hover {
				background: #0369a1;
			}
			.countdown-note {
				font-size: 0.8rem;
				color: #94a3b8;
				margin-top: 1rem;
			}
		</style>
	</head>
	<body>
		<div class="redirect-card">
			<span class="badge">✈️ ページ移転のお知らせ</span>
			<h1>ANAちいかわジェット運航情報は<br>『ヨミトク』へ移転しました</h1>
			<p>
				「ちいかわジェット（JA609A）」の本日のリアルタイム運航状況、ダイヤ予想、フライト追跡情報は、特化メディア『ヨミトク（yomilee）』にて毎日自動更新中です。
			</p>
			<a href={targetUrl} class="btn-redirect">
				最新の運航ダッシュボードを開く ➔
			</a>
			<div class="countdown-note">
				※自動的に転送されない場合は、上のボタンをクリックしてください。
			</div>
		</div>
	</body>
</html>
